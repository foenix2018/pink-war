def chan(name,n,path,times,values): A.setdefault(name,[]).append((n,path,np.array(times,np.float32),np.array(values,np.float32)))
def rot(name,n,t,angles): chan(name,n,'rotation',t,Rotation.from_euler('xyz',np.array(angles)+rest.get(n,0)).as_quat())
def tr(name,n,t,vals): chan(name,n,'translation',t,vals)
