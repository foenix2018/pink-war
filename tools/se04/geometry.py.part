P=np.pi
materials=[]
def mat(name,c,metal=.7,rough=.42,em=None):
 d={'name':name,'pbrMetallicRoughness':{'baseColorFactor':[*c,1],'metallicFactor':metal,'roughnessFactor':rough}}
 if em: d['emissiveFactor']=em; d['extensions']={'KHR_materials_emissive_strength':{'emissiveStrength':2.0}}
 materials.append(d); return len(materials)-1
armor=mat('Gunmetal worn armor',(.22,.205,.19)); light=mat('Ceramic grey armor',(.31,.29,.27)); dark=mat('Dark graphite frame',(.032,.037,.043)); edge=mat('Machined steel',(.23,.25,.27),.9,.3); black=mat('Recesses',(.015,.019,.025),.25); track=mat('Track links',(.13,.12,.12),.85); rubber=mat('Track pads',(.035,.033,.034),.05,.85); red=mat('Crimson energy',(.8,.015,.07),.15,.28,[1,.008,.045]); blue=mat('Cyan optic',(.02,.47,.8),.1,.21,[.01,.55,1]); ivory=mat('Stencilled paint',(.68,.64,.58),.1,.65); copper=mat('Oxidised fasteners',(.34,.17,.095),.8); glass=mat('Optical center',(.45,.85,1),.1,.2,[.2,.7,1]); scratch=mat('Edge wear',(.51,.47,.43),.65,.55)
charcoal=mat("Charcoal ceramic",(.10,.097,.092),.72,.62); pale=mat("Titanium facets",(.39,.36,.33),.82,.48); orange=mat("Warning paint",(.52,.19,.035),.25,.7); brass=mat("Hydraulic fittings",(.28,.22,.14),.85,.35)
flare=mat('Cannon flash',(1,.34,.035),.0,.3,[1,.4,.035]); flarecore=mat('Cannon flash core',(1,.86,.4),.0,.3,[1,.85,.35])
nodes=[]; geo=defaultdict(lambda:defaultdict(list)); anims=[]
def node(name,t=(0,0,0),parent=None):
 i=len(nodes); nodes.append({'name':name,'translation':list(t)})
 if parent is not None: nodes[parent].setdefault('children',[]).append(i)
 return i
def mesh(n,m,v,f):
 v=np.array(v,float); f=np.array(f,int); p=v[f]; norm=np.cross(p[:,1]-p[:,0],p[:,2]-p[:,0]); norm/=np.maximum(1e-9,np.linalg.norm(norm,axis=1))[:,None]; geo[n][m].append((p.reshape(-1,3),np.repeat(norm,3,axis=0)))
def hull(n,m,v):
 v=np.array(v); h=ConvexHull(v); f=h.simplices.copy(); p=v[f]; norm=np.cross(p[:,1]-p[:,0],p[:,2]-p[:,0]); flip=(norm*h.equations[:,:3]).sum(1)<0; f[flip]=f[flip][:,[0,2,1]]; mesh(n,m,v,f)
def box(n,m,c,s,b=.03,rot=None):
 h=np.array(s)/2; b=min(b,min(h)*.8); v=[]
 for a in range(3):
  for signs in np.ndindex(2,2,2):
   q=h-b; q=q.copy(); q[a]=h[a]; v.append(q*(np.array(signs)*2-1))
 v=np.array(v); v=v if rot is None else v@Rotation.from_euler('xyz',rot).as_matrix().T; hull(n,m,v+np.array(c))
def cyl(n,m,a,b,r,r2=None,k=12,inner=None):
 a=np.array(a,float); b=np.array(b,float); d=b-a; d/=np.linalg.norm(d); u=np.cross(d,[0,1,0] if abs(d[1])<.95 else [1,0,0]); u/=np.linalg.norm(u); w=np.cross(d,u); angles=np.arange(k)*2*P/k; q=np.cos(angles)[:,None]*u+np.sin(angles)[:,None]*w; r2=r if r2 is None else r2; v=np.concatenate([a+r*q,b+r2*q]); f=[]
 for j in range(k):
  l=(j+1)%k; f.extend([[j,l,k+l],[j,k+l,k+j]])
 if inner is None:
  v=np.vstack([v,a,b])
  for j in range(k): l=(j+1)%k; f.extend([[2*k,l,j],[2*k+1,k+j,k+l]])
 else:
  v=np.vstack([v,a+inner*q,b+inner*q])
  for j in range(k):
   l=(j+1)%k; f.extend([[2*k+j,3*k+l,2*k+l],[2*k+j,3*k+j,3*k+l],[j,2*k+l,l],[j,2*k+j,2*k+l],[k+j,k+l,3*k+l],[k+j,3*k+l,3*k+j]])
 mesh(n,m,v,f)
def bolt(n,x,y,z,r=.025): cyl(n,black,(x,y,z-.005),(x,y,z+.004),r*1.38,k=12); cyl(n,edge,(x,y,z+.004),(x,y,z+.010),r*.85,k=8); cyl(n,black,(x,y,z+.010),(x,y,z+.012),r*.34,k=6)
def shell(n,poly,z,depth,m=armor,slope=0,bolts=True):
 p=np.array(poly,float); mid=p.mean(0); rings=[]
 for f,o in [(0.89,-depth),(1,-min(.065,depth*.45)),(.88,0)]:
  for q in mid+(p-mid)*f: rings.append([q[0],q[1],z+slope*(q[1]-mid[1])+o])
 hull(n,m,rings)
 if bolts:
  for q in mid+(p-mid)*.79: bolt(n,*q,z+slope*(q[1]-mid[1])+.002,.014)
def plate(n,c,s,m=armor,rot=None):
 x,y,z=c; w,h,d=s; poly=[(-.50,.23),(-.28,.50),(.22,.50),(.50,.29),(.47,-.24),(.22,-.50),(-.30,-.43),(-.50,-.20)]
 name=nodes[n]['name']
 if name.startswith('Hip_joint'): poly=[(-.39,.38),(-.15,.50),(.35,.43),(.50,.12),(.32,-.43),(-.10,-.50),(-.48,-.32)]
 elif name.startswith('Knee_'): poly=[(-.48,.20),(-.22,.50),(.29,.45),(.50,.07),(.25,-.50),(-.37,-.43)]
 elif name.startswith('Shoulder_'): poly=[(-.48,.22),(-.19,.50),(.30,.40),(.50,.06),(.36,-.39),(-.26,-.50),(-.46,-.22)]
 q=np.array([[a*w,b*h,0] for a,b in poly]); q=q if rot is None else q@Rotation.from_euler('xyz',rot).as_matrix().T
 shell(n,[(x+a,y+b) for a,b,c in q],z+d*.5+.04,d+.03,m,-.15)
def piston(n,a,b,r=.065):
 a=np.array(a); b=np.array(b); p=a+(b-a)*.57; cyl(n,dark,a,p,r*1.27); cyl(n,edge,p,b,r*.65); cyl(n,edge,a,a+(b-a)*.13,r*1.44)
def vent(n,c,count=4,step=.075):
 for i in range(count): box(n,black,(c[0]+(i-(count-1)/2)*step,c[1],c[2]),(.035,.17,.018),.006, (0,0,-.16))
def led(n,c,s=(.055,.22,.028),rot=None): box(n,black,c,np.array(s)+[.055,.04,.015],.014,rot); box(n,red,np.array(c)+[0,0,.018],s,.009,rot)
