 shoulder=node('Shoulder_'+side,(s*1.00,.67,0),torso); elbow=node('Elbow_'+side,(s*.11,-.79,.015),shoulder); arms.append((shoulder,elbow))
 cyl(shoulder,dark,(-.27,0,0),(.27,0,0),.27,k=16); cyl(shoulder,edge,(-.3,0,0),(.3,0,0),.18,k=16); box(shoulder,dark,(s*.05,-.31,0),(.30,.60,.36),.09); plate(shoulder,(s*.06,-.09,.17),(.78,.72,.46),light,(0,s*.13,-s*.22)); led(shoulder,(s*.19,-.17,.42),(.052,.17,.025),(0,0,-s*.18))
 for j in range(3): box(shoulder,edge,(s*.34,-.04-j*.11,-.08),(.06,.052,.29),.012)
 for x in [-.12,.12]: piston(shoulder,(x,-.20,.15),(x,-.65,.15),.090)
 cyl(elbow,dark,(-.27,0,0),(.27,0,0),.18,k=16); box(elbow,dark,(0,-.30,.03),(.52,.56,.47),.08); plate(elbow,(0,-.24,.19),(.68,.56,.40),armor); led(elbow,(s*.19,-.22,.395),(.055,.23,.025))
 recoil=node('Cannon_recoil_'+side,(0,-.40,.14),elbow)
 for x in [-.135,.135]:
  cyl(recoil,dark,(x,0,0),(x,-.78,.035),.126,k=16); cyl(recoil,edge,(x,-.05,0),(x,-.19,.01),.145,k=16); cyl(recoil,armor,(x,-.22,.01),(x,-.71,.03),.114,k=16); cyl(recoil,edge,(x,-.70,.03),(x,-.83,.038),.139,k=20,inner=.092); cyl(recoil,red,(x,-.83,.038),(x,-.845,.039),.120,k=32,inner=.108); cyl(recoil,black,(x,-.75,.033),(x,-.78,.035),.091,k=16)
 for x in [-.135,.135]:
  flash=node('MuzzleFX_'+side+'_'+str(x),(x,-.845,.039),recoil); nodes[flash]['scale']=[0,0,0]; cyl(flash,flare,(0,0,0),(0,-.40,.018),.065,.006,k=8); cyl(flash,flarecore,(0,-.025,0),(0,-.26,.01),.043,.003,k=8)
 arms[-1]+=(recoil,)
 thigh=node('Hip_joint_'+side,(s*.59,-.10,0),hip); knee=node('Knee_'+side,(s*.075,-.77,0),thigh); ankle=node('Ankle_'+side,(s*.065,-.90,0),knee); legs.append((thigh,knee,ankle))
 cyl(thigh,dark,(-.27,0,0),(.27,0,0),.25,k=16); box(thigh,dark,(0,-.30,0),(.43,.65,.45),.09); plate(thigh,(0,-.27,.22),(.64,.72,.31),light); vent(thigh,(0,-.28,.41),3,.085)
 hull(thigh,armor,[(s*.24,-.02,-.19),(s*.39,-.11,-.12),(s*.39,-.48,-.10),(s*.24,-.62,-.16),(s*.24,-.02,.17),(s*.39,-.11,.23),(s*.39,-.48,.24),(s*.24,-.62,.14)])
 for j in range(3): box(thigh,copper,(s*.225,-.44-j*.042,.397),(.075,.018,.012),.003,(0,0,s*.4))
