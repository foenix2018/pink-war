legs=[]; arms=[]; pods=[]; wheels=[]; links=[]
def path(t):
 R=.275; L=.38; a=2*L; b=P*R; q=(t%1)*(2*a+2*b)
 if q<a: return R,-L+q,0
 q-=a
 if q<b:
  u=q/R; return R*math.cos(u),L+R*math.sin(u),u
 q-=b
 if q<a: return -R,L-q,P
 q-=a; u=q/R; return -R*math.cos(u),-L-R*math.sin(u),P+u
