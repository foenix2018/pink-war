 for x in [-.17,.17]: piston(knee,(x,-.19,.08),(x,-.76,.12),.096)
 hull(knee,light,[(s*.19,-.20,-.16),(s*.37,-.29,-.11),(s*.34,-.57,-.14),(s*.18,-.67,-.15),(s*.19,-.20,.16),(s*.37,-.29,.27),(s*.34,-.57,.22),(s*.18,-.67,.15)])
 plate(knee,(0,-.41,-.14),(.54,.48,.28),armor); box(knee,light,(s*.28,-.40,0),(.14,.49,.42),.07)
 foot=node('Track_'+side,(0,0,.08),ankle); box(foot,dark,(0,0,0),(.64,.40,1.03),.10); box(foot,armor,(0,.26,-.05),(.69,.27,.85),.10); plate(foot,(0,.25,.35),(.61,.27,.25),light); led(foot,(s*.22,.23,.51),(.048,.12,.023))
 for z,r in [(-.38,.215),(-.13,.175),(.13,.175),(.38,.215)]:
  wh=node('Wheel_'+side+'_'+str(z),(0,-.025,z),foot); wheels.append(wh); cyl(wh,rubber,(-.35,0,0),(.35,0,0),r,k=20); cyl(wh,edge,(-.37,0,0),(.37,0,0),r*.75,k=16); cyl(wh,dark,(-.39,0,0),(.39,0,0),r*.42,k=12)
  for j in range(6):
