 box(pod,dark,(0,0,0),(.76,.80,.83),.13); box(pod,armor,(0,-.006,-.04),(.74,.77,.80),.12); box(pod,edge,(0,0,.385),(.74,.73,.14),.10); box(pod,black,(0,0,.47),(.67,.65,.045),.07)
